<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Preview area placeholder: wire a PlayerView here bound to the active clip / full
         composition preview once you build sequence playback (ExoPlayer supports playing
         a Composition preview via CompositionPlayer in newer Media3 releases). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <RadioGroup
        android:id="@+id/orientationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/btnOrientationLandscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horizontal"
            android:checked="true" />

        <RadioButton
            android:id="@+id/btnOrientationPortrait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Vertical" />

        <RadioButton
            android:id="@+id/btnOrientationSquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Square" />
    </RadioGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timelineRecycler"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1A1A1A"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnAddClip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Add Video" />

        <Button
            android:id="@+id/btnAddAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Add Audio" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Export" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Add clips to get started" />

</LinearLayout>
